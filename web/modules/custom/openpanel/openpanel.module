<?php

/**
 * @file
 * Page attachment hooks for OpenPanel analytics.
 */

declare(strict_types=1);

use Drupal\Component\Serialization\Json;
use Drupal\Core\Render\Markup;
use Drupal\openpanel\Service\EndpointResolver;
use Drupal\openpanel\Service\PathExclusion;

/**
 * Implements hook_page_attachments().
 */
function openpanel_page_attachments(array &$attachments): void {
  if (\Drupal::service('openpanel.path_exclusion')->isExcluded()) {
    return;
  }

  $config = \Drupal::config('openpanel.settings');
  $client_id = trim((string) $config->get('client_id'));
  if ($client_id === '') {
    return;
  }

  /** @var \Drupal\openpanel\Service\EndpointResolver $endpoint_resolver */
  $endpoint_resolver = \Drupal::service('openpanel.endpoint_resolver');
  /** @var \Drupal\openpanel\Service\SecretResolver $secret_resolver */
  $secret_resolver = \Drupal::service('openpanel.secret_resolver');

  $init = [
    'clientId' => $client_id,
    'apiUrl' => $endpoint_resolver->getApiUrl(),
    'trackScreenViews' => (bool) $config->get('track_screen'),
    'trackOutgoingLinks' => (bool) $config->get('track_outgoing'),
    'trackAttributes' => (bool) $config->get('track_attributes'),
  ];

  // When using the Drupal proxy, the secret is injected server-side.
  // For self-hosted Domain mode, pass it to the SDK so direct API calls are authenticated.
  if ($endpoint_resolver->isSelfHosted()) {
    $secret = $secret_resolver->getSecret();
    if ($secret !== NULL) {
      $init['clientSecret'] = $secret;
    }
  }

  $bootstrap = '(function(){window.op=window.op||function(){(window.op.q=window.op.q||[]).push(arguments)};window.op(\'init\',' . Json::encode($init) . ');})();';

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#value' => Markup::create($bootstrap),
      '#attributes' => ['data-openpanel' => 'bootstrap'],
    ],
    'openpanel_bootstrap',
  ];

  $local_op_js_url = $endpoint_resolver->getLocalOpJsUrl();

  $attachments['#attached']['html_head_link'][][] = [
    'rel' => 'preload',
    'href' => $local_op_js_url,
    'as' => 'script',
  ];

  $attachments['#attached']['html_head'][] = [
    [
      '#type' => 'html_tag',
      '#tag' => 'script',
      '#attributes' => [
        'src' => $local_op_js_url,
        'defer' => 'defer',
        'async' => 'async',
        'data-openpanel' => 'sdk',
      ],
    ],
    'openpanel_sdk',
  ];
}
