{
    "name": "d-deck/starter",
    "description": "DDeck project Starter",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Vahe Chahbenderian",
            "homepage": "https://www.drupal.org/u/wwwahe"
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "cweagans/composer-patches": "^2.0",
        "ddeck-common/news-recipe": "dev-main",
        "drupal/add_content_by_bundle": "^2.0",
        "drupal/ai": "^1.3",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_ckeditor": "^1.5@beta",
        "drupal/ai_provider_openai": "^1.2",
        "drupal/ai_search": "^1.3@alpha",
        "drupal/ai_translate": "^1.3",
        "drupal/ai_vdb_provider_qdrant": "^1.3",
        "drupal/ajax_comments": "^1.0@beta",
        "drupal/backup_migrate": "^5.1",
        "drupal/better_exposed_filters": "^8.0@alpha",
        "drupal/block_class": "^4.0",
        "drupal/block_field": "^1.0@RC",
        "drupal/blockgroup": "^2.0",
        "drupal/book": "^3.0",
        "drupal/bootstrap_color_modes_toggler": "^2.0@alpha",
        "drupal/canvas": "^1.12",
        "drupal/ckeditor5_bootstrap": "^1.0",
        "drupal/ckeditor5_bootstrap_accordion": "^1.0",
        "drupal/ckeditor5_max_block_width": "^1.0@alpha",
        "drupal/ckeditor_details": "^2.2@beta",
        "drupal/code_component": "^1.0@alpha",
        "drupal/coffee": "^2.0",
        "drupal/color_field": "^3.0",
        "drupal/config_ignore": "^3.4",
        "drupal/config_partial_export": "^2.0@beta",
        "drupal/context": "^5.0@RC",
        "drupal/core": "^11.4",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recipe-unpack": "^11",
        "drupal/core-recommended": "^11",
        "drupal/ddeck_advanced_media": "^1.0@alpha",
        "drupal/ddeck_entity_social_share": "^2.0@alpha",
        "drupal/diff": "^2.0",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/edit_media_modal": "^2.1",
        "drupal/element_class_formatter": "^2.1",
        "drupal/embedded_content_sdc": "^1.0",
        "drupal/entity_browser": "^2.15",
        "drupal/entity_hierarchy": "^5.0@RC",
        "drupal/entity_page_title_manage_display": "^1.0@alpha",
        "drupal/entity_pager": "^2.0@alpha",
        "drupal/entity_reference_revisions": "^1.14",
        "drupal/entity_stretched_link": "^1.0@alpha",
        "drupal/eva": "^3.1",
        "drupal/fences": "^3.0",
        "drupal/fences_block": "^2.0",
        "drupal/field_formatter_class": "^1.9",
        "drupal/field_group": "^4.1@beta",
        "drupal/filepond": "^1.0@alpha",
        "drupal/focal_point": "^2.1",
        "drupal/gin": "^5.0",
        "drupal/gin_toolbar": "^3.0",
        "drupal/helper_class": "^1.0@alpha",
        "drupal/htmx": "^2.0@beta",
        "drupal/inline_entity_form": "^3.0",
        "drupal/link_attributes": "^2.1",
        "drupal/manage_display": "^3.0",
        "drupal/masquerade": "^2.2",
        "drupal/menu_link_attributes": "^1.10",
        "drupal/metatag": "^2.2",
        "drupal/oembed_providers": "^3.0",
        "drupal/og": "^2.0",
        "drupal/openai_image_for_drupal": "^2.0",
        "drupal/pathauto": "^1.14",
        "drupal/prevnext": "^4.0",
        "drupal/prism": "^2.2",
        "drupal/profile": "^1.14",
        "drupal/quickedit": "^2.0",
        "drupal/radix": "^6.0",
        "drupal/radix_admin": "^6.0@alpha",
        "drupal/realname": "^2.0",
        "drupal/redirect": "^1.13",
        "drupal/registration": "^3.4",
        "drupal/scheduler": "^2.2",
        "drupal/search_api": "^1.41",
        "drupal/social_link_field": "^2.1",
        "drupal/speculative_loading": "^1.0@beta",
        "drupal/stringoverrides": "^2.0",
        "drupal/tagify": "^1.2.50",
        "drupal/toc_filter": "^2.4",
        "drupal/token": "^1.17",
        "drupal/trash": "^3.0",
        "drupal/ui_icons": "^1.1",
        "drupal/url_embed": "^3.0",
        "drupal/views_entity_embed": "^2.1",
        "drupal/views_linkarea": "^2.0",
        "drupal/votingapi_reaction": "^1.13",
        "drupal/workflow_buttons": "^1.0@beta",
        "drush/drush": "^13",
        "joachim-n/composer-manifest": "^1.0",
        "npm-asset/apexcharts": "^8.6",
        "npm-asset/photoswipe": "^5.4",
        "npm-asset/shiki": "^4.5",
        "npm-asset/videojs--cdn": "^10.0",
        "npm-asset/yaireo--tagify": "^4.36",
        "oomphinc/composer-installers-extender": "^2.0.0",
        "pantheon-systems/drupal-integrations": "^11",
        "wikimedia/composer-merge-plugin": "^2.1",
        "zaporylie/composer-drupal-optimizations": "^1.2"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "drupal/core-dev": "^11",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-recipe-unpack": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true,
            "php-tuf/composer-integration": true,
            "cweagans/composer-patches": true,
            "oomphinc/composer-installers-extender": true,
            "wikimedia/composer-merge-plugin": true,
            "zaporylie/composer-drupal-optimizations": true,
            "tbachert/spi": true,
            "joachim-n/composer-manifest": true,
            "symfony/runtime": true,
            "mnsami/composer-custom-directory-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "drupal-scaffold": {
            "allowed-packages": [
                "pantheon-systems/drupal-integrations"
            ],
            "locations": {
                "web-root": "web/"
            }
        },
        "enable-patching": true,
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "tests/cypress/cypress/support/{$name}": [
                "type:cypress-support"
            ],
            "tests/cypress/cypress/e2e/{$name}": [
                "type:cypress-e2e"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/private/scripts/quicksilver/{$name}/": [
                "type:quicksilver-script"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "installer-types": [
            "npm-asset",
            "bower-asset",
            "cypress-support",
            "cypress-e2e"
        ],
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "CSS validation rules fix " : "./patches/css-validation-fix.patch",
                "Disable navigation Top bar" : "./patches/disable-navigation-topbar.patch",
                "CSS validation fix" : "https://www.drupal.org/files/issues/2026-08-17/3187258-css_class_validation.36.patch"
            },
            "drupal/field_group" : {
                "[#3192985] CSS validation fix" : "https://www.drupal.org/files/issues/2021-01-15/allow_more_chars_in_css_classes.patch"
            }
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    }
}
